        <mxCell id="title" value="&lt;b&gt;Autonomous CodeCrunch Organizer — System Architecture&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=28;fontColor=#1a1a1a;" vertex="1" parent="1">
